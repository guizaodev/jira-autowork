# jira-autowork — variáveis de ambiente
# Copie para .env e preencha: cp .env.example .env

# Porta do servidor (painel + API)
PORT=3000

# Senha de acesso ao painel web (obrigatória em produção)
PANEL_PASSWORD=

# Cookie de sessão do Jira (seed inicial; opcional — pode ser configurado/renovado
# pelo painel em Config → Cookie). Formato (1 linha):
# JSESSIONID=...; atlassian.xsrf.token=...; INGRESSCOOKIE=...
JIRA_COOKIE=

# Cookie de sessão do painel com flag Secure:
#   true  — painel servido atrás de proxy TLS (https)
#   false — painel servido em http puro (default)
#   auto  — decide por request via header x-forwarded-proto
PANEL_COOKIE_SECURE=false

# Diretório do banco SQLite (no container, /data via volume)
DATA_DIR=./data

# Fuso do processo (apontamento às 09:05 America/Sao_Paulo)
TZ=America/Sao_Paulo

# Webhook de alertas: configurado no painel (Config → Webhook), não por env.
# ALERT_WEBHOOK_URL é lido apenas pelo docker-compose como conveniência de seed.
